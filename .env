const doc = new PDFDocument({ margin: 50 });
let buffers = [];

doc.on("data", buffers.push.bind(buffers));

doc.on("end", async () => {
    const pdfData = Buffer.concat(buffers);

    if (email) {
        await transporter.sendMail({
            from: `"Peru Luxury Journeys" <${EMAIL_USER}>`,
            to: email,
            subject: 'Your Travel Evaluation Summary',
            html: `<h2>Thank you ${nombre}</h2><p>Your PDF is attached</p>`,
            attachments: [{ filename: `evaluacion-${nombre}.pdf`, content: pdfData }]
        });
    }

    res.json({ mensaje: '¡Evaluación procesada con éxito!' });
});


// ===== HEADER =====
doc.rect(0, 0, doc.page.width, 90).fill("#244365");

doc
    .fillColor("#ffffff")
    .fontSize(20)
    .text("Peru Luxury Journeys", 50, 30);

doc
    .fontSize(12)
    .text("Travel Evaluation Summary", 50, 55);

doc.moveDown(3);


// ===== DATOS CLIENTE =====
doc.fillColor("#000")
   .fontSize(14)
   .text("Client Information", { underline: true });

doc.moveDown(0.5);

doc.fontSize(11);
doc.text(`Name: ${nombre}`);
doc.text(`Email: ${email || "Not provided"}`);
doc.text(`Travel Date: ${fecha}`);

doc.moveDown();

doc.moveTo(50, doc.y)
   .lineTo(550, doc.y)
   .strokeColor("#ccc")
   .stroke();

doc.moveDown();


// ===== FUNCION MEJORADA =====
const dibujarSeccion = (titulo, datos, headers, keys) => {
    const datosValidos = datos.filter(item =>
        Object.values(item).some(val => val && val !== "No evaluado")
    );

    if (datosValidos.length > 0) {

        // Titulo
        doc.fillColor("#244365")
           .fontSize(13)
           .text(titulo);

        doc.moveDown(0.5);

        // Encabezados
        doc.fillColor("#000")
           .fontSize(10)
           .text(headers[0], 50, doc.y, { continued: true })
           .text(headers[1], 350);

        doc.moveDown(0.3);

        doc.moveTo(50, doc.y)
           .lineTo(550, doc.y)
           .strokeColor("#aaa")
           .stroke();

        doc.moveDown(0.5);

        // Filas
        datosValidos.forEach(item => {
            let label = keys.length > 2
                ? `${item[keys[0]]} - ${item[keys[1]]}`
                : item[keys[0]];

            let valor = keys.length > 2
                ? item[keys[2]]
                : item[keys[1]];

            doc.fillColor("#333")
               .text(label || "N/A", 50, doc.y, { continued: true })
               .text(valor || "No evaluado", 350);

            doc.moveDown(0.3);
        });

        doc.moveDown();
    }
};


// ===== SECCIONES =====
dibujarSeccion("Hotel Transfers", hotelTransfer, ["Location", "Rating"], ["hotelTransfer_name", "hotelTransfer_calificacion"]);
dibujarSeccion("Tours & Guides", tours, ["Tour", "Rating"], ["tours_name", "tours_calificacion"]);
dibujarSeccion("Hotels", hotel, ["Hotel", "Rating"], ["hotel_name", "hotel_calificacion"]);
dibujarSeccion("Restaurants", restaurantes, ["Restaurant", "Rating"], ["restaurante_ubicacion", "restaurante_name", "restaurante_calificacion"]);


// ===== COMENTARIO =====
if (comentario && comentario !== "Sin comentarios") {
    doc.fillColor("#244365")
       .fontSize(13)
       .text("Comments");

    doc.moveDown(0.5);

    doc.fillColor("#333")
       .fontSize(11)
       .text(comentario, {
           width: 500
       });

    doc.moveDown();
}


// ===== CALIFICACION DESTACADA =====
doc.moveDown();

doc.rect(50, doc.y, 500, 40).fill("#f2f2f2");

doc.fillColor("#000")
   .fontSize(12)
   .text("Overall Rating:", 60, doc.y + 10, { continued: true });

doc.fillColor("#244365")
   .fontSize(16)
   .text(` ${calificacion} / 10`);

doc.moveDown(3);


// ===== FOOTER =====
doc.fontSize(9)
   .fillColor("#888")
   .text("© 2026 Peru Luxury Journeys - Lima, Peru", {
       align: "center"
   });

doc.end();